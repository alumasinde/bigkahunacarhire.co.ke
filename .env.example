# Copy this file to `.env` (same folder as this file, project root) and fill in
# your real values. Never commit the real `.env` to version control.

DB_HOST=127.0.0.1
DB_NAME=bigkahuna_carhire
DB_USER=your_db_user
DB_PASS=your_db_password

APP_ENV=production
# No trailing slash
APP_URL=https://bigkahunacarhire.co.ke

# ---------------------------------------------------------------
# M-Pesa Daraja (STK Push)
# ---------------------------------------------------------------
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# Paybill or Till number (sandbox default: 174379)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_lipa_na_mpesa_online_passkey
# Must be a public HTTPS URL Safaricom can reach. Leave blank to auto-build
# as {APP_URL}/mpesa/callback
MPESA_CALLBACK_URL=


# ---------------------------------------------------------------
# Paystack (online checkout)
# Test keys start with pk_test_ / sk_test_. Use live keys only in production.
# ---------------------------------------------------------------
PAYSTACK_ENABLED=1
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PAYSTACK_CALLBACK_URL=https://bigkahunacarhire.co.ke/payments/paystack/callback
PAYSTACK_WEBHOOK_URL=https://bigkahunacarhire.co.ke/payments/paystack/webhook

# ---------------------------------------------------------------
# Admin WhatsApp alerts (new booking / payment received) — CallMeBot
# free personal API. One-time setup: from the admin's own WhatsApp,
# message +34 644 59 71 60 with "I allow callmebot to send me messages",
# then paste the apikey they reply with below. Also set the admin's
# phone number in Admin -> Settings -> Notifications, and switch
# "Whatsapp Enabled" to Enabled there once this is filled in.
# ---------------------------------------------------------------
CALLMEBOT_APIKEY=
# WhatsApp Cloud API (Phase 3; leave blank while CallMeBot is used)
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=



# External Reviews — Google Business Profile + Tripadvisor
GOOGLE_REVIEW_CLIENT_ID=
GOOGLE_REVIEW_CLIENT_SECRET=
# Connect Google from Admin → Reviews → Connect Google.
# The refresh token is generated by OAuth and shown once for copying here.
# Account/location IDs are discovered automatically and saved in Reviews settings.
GOOGLE_REVIEW_REFRESH_TOKEN=
GOOGLE_REVIEW_ACCOUNT_ID=
GOOGLE_REVIEW_LOCATION_ID=
GOOGLE_REVIEW_REDIRECT_URI=https://bigkahunacarhire.co.ke/admin/reviews/google/callback
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=
TRIPADVISOR_BASE_URL=https://terra.tripadvisor.com/api/locations
